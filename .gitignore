# .gitignore

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
*.so
venv/
env/
.env
.venv

# ── Django ────────────────────────────────────────────────────────────────────
*.log
local_settings.py
db.sqlite3
staticfiles/
media/

# ── Environment ───────────────────────────────────────────────────────────────
.env
.env.local
.env.production
# Keep .env.example (it's a template, not secrets)

# ── Node / React ──────────────────────────────────────────────────────────────
node_modules/
dist/
.npm
*.tsbuildinfo

# ── Docker ────────────────────────────────────────────────────────────────────
# Don't ignore Dockerfile or docker-compose.yml — those belong in git

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.iml
.history/
.project-brain/
